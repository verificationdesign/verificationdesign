---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import FailureChooser from '../../components/FailureChooser.astro';
---

<BaseLayout
  title="Patterns"
  description="Reusable verification patterns for agentic systems, organized by context, verification, and orchestration."
  markdownPath="/patterns.md"
>
  <div class="patterns-page">
    <div class="landing-intro">
      <h1>Patterns</h1>
      <p class="patterns-orientation">
        Patterns are reusable verification structures for agentic systems.
        Each card names the failure it controls, the mechanism it uses, the
        observable signal it produces, and the evidence behind it. Two ways
        in: start from the failure you are seeing, or browse by family.
      </p>
      <div class="route-links">
        <a href="#by-failure-heading">Start from the failure</a>
        <a href="#by-family-heading">Browse by family</a>
      </div>
    </div>

    <FailureChooser headingLevel="h2" />

    <section class="by-family" aria-labelledby="by-family-heading">
      <h2 id="by-family-heading">Browse by family</h2>
      <CategoryGrid headingLevel="h3" />
    </section>
  </div>
</BaseLayout>
