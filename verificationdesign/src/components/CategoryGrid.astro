---
import { getCollection } from 'astro:content';

const cards = await getCollection('patterns');

type CategoryKey = 'context-and-state' | 'verification' | 'orchestration';

const grouped: Record<CategoryKey, typeof cards> = {
  'context-and-state': [],
  'verification': [],
  'orchestration': [],
};

for (const card of cards) {
  grouped[card.data.category as CategoryKey].push(card);
}

for (const key of Object.keys(grouped) as CategoryKey[]) {
  grouped[key].sort((a, b) => a.data.title.localeCompare(b.data.title));
}

const CATEGORY_INFO: Record<CategoryKey, { label: string; blurb: string }> = {
  'context-and-state': {
    label: 'Context and State',
    blurb: 'What exists before the model acts, and how to make it explicit.',
  },
  'verification': {
    label: 'Verification',
    blurb: 'How to turn judgment into observable signals.',
  },
  'orchestration': {
    label: 'Orchestration',
    blurb: 'How to control bias through independence and routing.',
  },
};

const visible = (Object.keys(CATEGORY_INFO) as CategoryKey[]).filter(
  (key) => grouped[key].length > 0,
);

interface Props {
  headingLevel?: 'h2' | 'h3';
  overview?: boolean;
}

const { headingLevel = 'h2', overview = false } = Astro.props;
const Heading = headingLevel;
---

<div class:list={["category-grid", { "family-overview": overview }]}>
  {visible.map((key) => (
    <section class:list={[overview ? "family-entry" : "category", key]} id={overview ? undefined : key}>
      <Heading class="category-title">
        {overview ? <a href={`/patterns/#${key}`}>{CATEGORY_INFO[key].label}</a> : CATEGORY_INFO[key].label}
      </Heading>
      <p class="category-blurb">
        {CATEGORY_INFO[key].blurb}
      </p>
      {overview ? (
        <span class="family-count" role="img" aria-label={`${grouped[key].length} patterns`}>
          {grouped[key].map(() => <span aria-hidden="true"></span>)}
          <span aria-hidden="true" class="family-total">{grouped[key].length}</span>
        </span>
      ) : (
        <ul class="card-list" role="list">
          {grouped[key].map((card) => (
            <li>
              <a href={`/patterns/${card.data.category}/${card.data.slug}/`}>
                <span class="card-title">{card.data.title}</span>
                {card.data.gloss && (
                  <span class="card-gloss">{card.data.gloss}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</div>
