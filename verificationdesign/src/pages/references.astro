---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { collectReferences } from '../lib/references';

const cards = await getCollection('patterns');
const references = await collectReferences(
  cards.map((card) => ({
    title: card.data.title,
    href: `/patterns/${card.data.category}/${card.data.slug}/`,
    body: card.body ?? '',
  })),
);
---

<BaseLayout
  title="References"
  description="A deduplicated bibliography extracted from the Verification Design principles, pattern-card evidence sections, and site page citations."
  markdownPath="/references.md"
>
  <div class="references-page">
    <h1>References</h1>
    <p>
      Bibliography extracted from canonical principles, pattern-card
      evidence sections, and the citations on this site's prose pages.
      Entries are deduplicated by link target.
    </p>

    <ol class="reference-list">
      {references.map((reference) => (
        <li>
          {reference.context && <span class="reference-context">{reference.context}</span>}
          <a href={reference.href}>{reference.label}</a>
          <span class="reference-sources">{' Cited from '}{reference.sources.map((source, index) => (
            <><a href={source.href}>{source.title}</a>{index === reference.sources.length - 1 ? '.' : ', '}</>
          ))}</span>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
