---
import { getCollection } from 'astro:content';
import { FAILURE_MAP } from '../lib/failure-map.mjs';
import { readCardCatalog } from '../content/loaders/cardsLoader.mjs';

const constitutionHref = '/patterns/context-and-state/constitution/';
const cards = await getCollection('patterns');
const selectedHrefs = new Set(cards.map((card) => `/patterns/${card.data.category}/${card.data.slug}/`));
const validHrefs = new Set((await readCardCatalog()).map(({ category, slug }) => `/patterns/${category}/${slug}/`));
const authoredHrefs = [...FAILURE_MAP.flatMap((entry) => entry.links.map(({ href }) => href)), constitutionHref];
const deadLinks = authoredHrefs.filter((href) => !validHrefs.has(href));

if (deadLinks.length > 0) {
  throw new Error(`Chooser links missing from the card collection: ${deadLinks.join(', ')}`);
}

interface Props {
  headingLevel: 'h2' | 'h3';
}

const { headingLevel: Heading } = Astro.props;
const RowHeading = Heading === 'h2' ? 'h3' : 'h4';
---
<section class="chooser" aria-labelledby="by-failure-heading">
  <Heading id="by-failure-heading">Start from the failure</Heading>
  <p class="chooser-lead">
    First the pain, then the pattern. Each failure lists the patterns to
    reach for, closest fit first.
  </p>
  <div class="chooser-list">
    {FAILURE_MAP.map((entry) => (
      <section class="chooser-card">
        <RowHeading>{entry.failure}</RowHeading>
        <p>{entry.shape}</p>
        <ul role="list">
          {entry.links.map((link) => (
            <li>{selectedHrefs.has(link.href) ? <a href={link.href}>{link.label}</a> : link.label}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="chooser-footer">
    If the failure is still unclear, start with
    {selectedHrefs.has(constitutionHref) ? <a href={constitutionHref}>Constitution</a> : 'Constitution'}.
    Most verification failures become easier to diagnose once the system has
    an explicit answer to what is being checked.
  </p>
</section>
