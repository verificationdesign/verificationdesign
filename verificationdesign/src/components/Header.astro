---
import ComparatorMark from './ComparatorMark.astro';
import { getUi } from '../i18n/ui';

const t = getUi();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const currentState = (route: string) => {
  const section = route.replace(/\/$/, '') || '/';
  if (path === section) return 'page';
  if (section !== '/' && path.startsWith(section + '/')) return 'true';
};
const isHome = currentState(t.routes.home) === 'page';
const navItems = [
  { route: t.routes.patterns, label: t.nav.patterns },
  { route: t.routes.principles, label: t.nav.principles },
  { route: t.routes.references, label: t.nav.references },
  { route: t.routes.about, label: t.nav.about },
];
---

<header class="site-header">
  <div class="header-inner">
    {isHome ? (
      <span class="brand brand-current">
        <ComparatorMark />
        <span class="brand-name">{t.siteName}</span>
      </span>
    ) : (
      <a href={t.routes.home} class="brand">
        <ComparatorMark />
        <span class="brand-name">{t.siteName}</span>
      </a>
    )}
    <nav aria-label={t.nav.primary}>
      <ul>
        {navItems.map(({ route, label }) => {
          const current = currentState(route);
          return (
            <li>
              {current === 'page' ? (
                <span class="nav-current" aria-current="page">{label}</span>
              ) : (
                <a href={route} class:list={{ 'nav-current': current }} aria-current={current}>{label}</a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
