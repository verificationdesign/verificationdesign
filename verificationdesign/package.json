{
  "name": "verificationdesign",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:twins": "node scripts/build-md-twins.mjs",
    "check:twins": "node scripts/check-md-twins.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "measure:cards": "node scripts/measure-card-heights.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint:cards": "python3 ../ai-design-patterns/scripts/lint_patterns.py",
    "lint:voice": "node scripts/lint-voice.mjs",
    "test:comparator-mark": "node scripts/check-comparator-mark-centering.mjs",
    "a11y": "pa11y-ci $(grep -rL 'http-equiv=\"refresh\"' dist --include='*.html')",
    "verify": "npm run build && npm run build:twins && npm run check:twins && npm run check:links && npm run check && npm run lint:cards && npm run lint:voice && npm run a11y",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "pa11y-ci": "^4.1.1",
    "typescript": "^5.4.0"
  }
}
